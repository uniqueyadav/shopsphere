# Copy this file to .env and replace the placeholders with local values.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
DB_URL=jdbc:mysql://localhost:3306/shopsphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Generate a random secret in PowerShell, then assign its output to
JWT_SECRET=
JWT_EXPIRY_SECONDS=86400
JWT_REFRESH_EXPIRY_SECONDS=2592000
# Optional one-time local SUPER_ADMIN bootstrap. Keep disabled after account creation.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Cloudinary credentials are required for seller product image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880
PRODUCT_IMAGE_MAX_COUNT=8
